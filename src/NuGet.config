<?xml version="1.0" encoding="utf-8"?>
<configuration>

    <!-- Restores for this solution use nuget.org only. The machine-wide configuration also lists a
         private Azure Artifacts feed, which needs credentials this repository has no use for: leaving it
         in makes every restore hang waiting on a feed that holds nothing we depend on. -->
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    </packageSources>

</configuration>
